{
  "name": "@nestjs/locks",
  "version": "0.0.6",
  "description": "Distributed locks for NestJS: run a scheduled job on one instance, keep runs from overlapping, and elect a leader, with leases and fencing tokens.",
  "keywords": [
    "nestjs",
    "nest",
    "distributed-lock",
    "lock",
    "locks",
    "cron",
    "scheduler",
    "leader-election",
    "lease",
    "fencing-token"
  ],
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "url": "https://github.com/nestjs/locks#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "oxlint lib/",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:e2e": "vitest run",
    "test:e2e:dev": "vitest",
    "prerelease": "npm run build",
    "release": "release-it",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-angular": "21.2.4",
    "@electric-sql/pglite": "0.5.16",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/drizzle": "0.0.2",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/testing": "12.5.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-orm": "0.45.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.93.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "reflect-metadata": "0.2.2",
    "release-it": "21.1.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs/locks"
  }
}
